{
  "name": "jangal",
  "private": true,
  "version": "0.1.0",
  "description": "Jangal (જંગલ) - The Family Forest. A private family tree app that runs in the browser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/ensure-viewer.mjs",
    "dev": "vite",
    "build:viewer": "vite build -c vite.viewer.config.ts && node scripts/finish-viewer.mjs",
    "build": "npm run build:viewer && tsc -b && vite build && vite build --ssr src/site/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/build-seo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "oxlint",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "wordmark": "node scripts/build-wordmark.mjs",
    "og": "node scripts/build-og.mjs",
    "screens": "node scripts/build-screens.mjs",
    "icons": "node scripts/build-icons.mjs",
    "hosts": "node scripts/gen-host-config.mjs",
    "icon-paths": "node scripts/build-icon-paths.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/noto-sans-gujarati": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.12.0",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "svg2pdf.js": "^2.8.1",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.48.2",
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "harfbuzzjs": "^1.6.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "sharp": "^0.34.5",
    "size-limit": "^14.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
